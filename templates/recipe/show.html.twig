{% extends 'base.html.twig' %}

{% block title %}Recipe{% endblock %}

{% block body %}
    <h1 class="text-center text-4xl mt-5">{{ recipe.name }}</h1>

    <div class="flex justify-center mt-5">
        <div class="bg-neutral-primary-soft block max-w-sm border border-default rounded-base shadow-xs">
            <a href="#">
                <img class="rounded-t-base" src="{{ asset('/uploads/images/' ~ recipe.image) }}" alt="" />
            </a>
            <div class="p-6 text-center">
                <p class="mt-3 mb-6 tracking-tight text-heading">Temps de préparation : {{ recipe.time }} minutes</p>
                {% for ingredient in recipe.ingredients %}
                <span class="inline-flex items-center bg-brand-softer border border-brand-subtle text-fg-brand-strong text-xs font-medium px-1.5 py-0.5 rounded-sm">
                    <svg class="w-3 h-3 me-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.122 17.645a7.185 7.185 0 0 1-2.656 2.495 7.06 7.06 0 0 1-3.52.853 6.617 6.617 0 0 1-3.306-.718 6.73 6.73 0 0 1-2.54-2.266c-2.672-4.57.287-8.846.887-9.668A4.448 4.448 0 0 0 8.07 6.31 4.49 4.49 0 0 0 7.997 4c1.284.965 6.43 3.258 5.525 10.631 1.496-1.136 2.7-3.046 2.846-6.216 1.43 1.061 3.985 5.462 1.754 9.23Z"/></svg>
                    {{ ingredient.name }}
                </span>
                {% endfor %}
                <a href="#">
                    <p class="mt-3 mb-6 tracking-tight text-heading">{{ recipe.description }}</p>
                </a>
                <p class="mt-3 mb-6 tracking-tight text-heading">Publié par {{ recipe.author.username }}</p>
            </div>
        </div>
    </div>

    <div class="flex justify-center mt-5 gap-5">
        <a class="text-white bg-brand box-border border border-transparent hover:bg-brand-strong focus:ring-4 focus:ring-brand-medium shadow-xs font-medium leading-5 rounded-full text-sm px-4 py-2.5 focus:outline-none" href="{{ path('app_recipe_index') }}">retour à la liste</a>
        {% if is_granted('ROLE_USER') %}
        <a class="text-white bg-warning box-border border border-transparent hover:bg-warning-strong focus:ring-4 focus:ring-warning-medium shadow-xs font-medium leading-5 rounded-full text-sm px-4 py-2.5 focus:outline-none" href="{{ path('app_recipe_edit', {'id': recipe.id}) }}">Modifier</a>
        {{ include('recipe/_delete_form.html.twig') }}
        {% endif %}
    </div>

{% endblock %}
